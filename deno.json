{
  "name": "@worlds/cloudflare",
  "version": "0.4.2",
  "description": "Cloudflare D1 durable backend for the Worlds client — RDF/JS quad primitive packaged with the worlds impl.",
  "license": "WTFPL",
  "nodeModulesDir": "auto",
  "lock": {
    "includePlatform": true
  },
  "minimumDependencyAge": 0,
  "exports": {
    ".": "./src/mod.ts",
    "./quad-store": "./src/cloudflare/quad-store/mod.ts",
    "./search-index": "./src/cloudflare/search-index/mod.ts",
    "./rdfjs-store": "./src/cloudflare/rdfjs-store/mod.ts",
    "./schema": "./src/cloudflare/schema/d1-schema-builder.ts"
  },
  "imports": {
    "@/": "./src/",
    "@langchain/textsplitters": "npm:@langchain/textsplitters@^1.0.1",
    "@rdfjs/types": "npm:@rdfjs/types@^2.0.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@wazoo/sparql-engine": "jsr:@wazoo/sparql-engine@^0.4.1",
    "@worlds/sqlite": "jsr:@worlds/sqlite@^0.6.0",
    "@worlds/sdk": "jsr:@worlds/sdk@^0.6.1",
    "miniflare": "npm:miniflare@^4.20260730.0"
  },
  "publish": {
    "include": [
      "src/",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "test/"
    ]
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check",
    "test": "deno test --allow-all",
    "publish:dry": "deno publish --dry-run --allow-dirty",
    "ci": {
      "description": "Formats, lints, checks, and tests the code",
      "dependencies": [
        "fmt:check",
        "lint",
        "check",
        "test"
      ]
    }
  }
}
